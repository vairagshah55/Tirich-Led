# ── Route serving: pre-rendered file first, then SPA, then a real 404 ──
#
# postbuild writes 131 route-specific HTML files (build/products/pro-116/
# index.html, build/products/category/downlights/index.html, …), each with its
# own title, description, canonical, OG tags and JSON-LD. A blanket
# "everything -> /index.html" rewrite would shadow every one of them and hand
# crawlers the generic shell instead, so the order below matters:
#
#   1. request maps to a real file or directory  -> serve it
#      (this is the pre-rendered route HTML; mod_dir adds the trailing slash
#       our canonicals use, so each route has exactly one 200 URL)
#   2. request is a client-only app route        -> /index.html, React Router
#      resolves it (these are the only routes with no pre-rendered file)
#   3. anything else                             -> real HTTP 404 + /404.html
#
# Step 3 is why unknown URLs are not rewritten to /index.html: that answers a
# dead URL with HTTP 200 and gets it indexed as a soft 404.
#
# The rules between the @generated markers are rewritten on every build by
# scripts/prerender-meta.js from SPA_FALLBACK_PATTERNS in
# scripts/seo-shared.js. Edit them there, not here.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Canonical host: www -> non-www ────────────────────────────────
  # www.tirichled.com was serving the full site with HTTP 200 rather than
  # redirecting, so every page existed at two hostnames. The canonical tags all
  # point at the non-www form, so Google would have consolidated them
  # eventually, but until it does the crawl budget is split across two copies
  # and the brand's signals are divided between two hosts — which a new domain
  # with no inbound links can least afford.
  #
  # Must run before the route rules below, so the redirect happens once, up
  # front, rather than after a route has already been resolved.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  RewriteRule ^index\.html$ - [L]

  # ── Canonical URL form: no trailing slash ─────────────────────────
  # Each route is a directory holding index.html. DirectorySlash Off (below the
  # rewrite block) stops mod_dir 301ing /about to /about/, and this rule serves
  # /about straight out of about/index.html. So:
  #
  #   /about   -> 200, served from about/index.html
  #   /about/  -> 200, the same file
  #
  # BOTH forms answer 200 and NEITHER redirects. That is deliberate.
  #
  # There was a `RewriteRule ^(.+)/$ /$1 [R=301,L]` here to fold /about/ into
  # /about. It caused ERR_TOO_MANY_REDIRECTS in real browsers, because a 301 is
  # permanent and browsers cache it indefinitely: anyone who had visited while
  # the site still 301'd /about -> /about/ had that stored, so the new reverse
  # redirect completed a loop entirely inside their browser, with the server
  # never involved. Purging the CDN cannot fix a redirect cached on a client.
  #
  # Serving both forms as 200 makes such a loop impossible in either direction,
  # whatever any client has cached. The duplicate URL is handled the correct
  # way instead — every page's <link rel="canonical"> names the no-slash form,
  # and that is what the sitemap, JSON-LD and internal links all emit, so only
  # one URL is ever advertised or indexed.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*?)/?$ /$1/index.html [L]

  # @generated:spa-fallback
  # (populated at build time. This bare default serves the empty app shell —
  #  never /index.html, which is the pre-rendered homepage: hydrating /login
  #  against homepage markup would be a mismatch.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /app-shell.html [L]
  # @end:spa-fallback
</IfModule>

# Required by the canonical-URL rules above: without this, mod_dir redirects
# /about to /about/ before the rewrites ever run, and the no-slash form could
# never be served. -Indexes is the safety pairing — with DirectorySlash off, a
# directory lacking index.html must not fall back to a generated listing.
DirectorySlash Off
Options -Indexes

# Serves the pre-rendered noindex 404 page with a real 404 status.
ErrorDocument 404 /404.html

# ── Private routes: noindex at the HTTP level ───────────────────────
# The app-only routes above are answered with the SPA shell, whose static <head>
# necessarily says index,follow (it is the homepage's shell). The runtime <Seo>
# replaces that with noindex,nofollow, but only for crawlers that execute JS.
# This header does not depend on JS and takes precedence, so a raw fetch of
# /login or the lead inbox is never indexable.
#
# Rules between the markers are regenerated on every build from
# SPA_FALLBACK_PATTERNS in scripts/seo-shared.js.
<IfModule mod_headers.c>
  # @generated:private-noindex
  SetEnvIf Request_URI "^/(login|dashboard|ai-studio|leads-)" TIRICH_PRIVATE_ROUTE
  # @end:private-noindex
  Header set X-Robots-Tag "noindex, nofollow" env=TIRICH_PRIVATE_ROUTE
</IfModule>

# ── Caching (helps the slow-first-load work) ────────────────────────
# Hashed build assets (main.<hash>.js etc.) are immutable — cache them
# for a year. index.html must never be cached so new deploys are picked
# up immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpe?g|svg|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(^index\.html$|service-worker\.js$)">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Gzip/Brotli compression ─────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

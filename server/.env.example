PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS — frontend origin
CLIENT_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/tirichled

# Email notifications (Resend — free 3000 emails/month)
RESEND_API_KEY=your-resend-api-key
NOTIFY_EMAIL=where-to-receive@example.com

# WhatsApp notifications (Meta Cloud API — free 1000 conversations/month)
WA_TOKEN=your-whatsapp-cloud-api-token
WA_PHONE_ID=your-phone-number-id
WA_NOTIFY_NUMBER=919586556384
